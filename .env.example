# Copy to .env.local (Next.js) AND mirror to .env (the Trigger.dev worker
# reads .env). Values here are placeholders — never commit real secrets.

# --- Database (Supabase Postgres) ---
DATABASE_URL="postgresql://user:pass@host:6543/postgres?pgbouncer=true"   # Supavisor pooler (runtime)
DIRECT_URL="postgresql://user:pass@host:5432/postgres"                    # direct (migrations)

# --- Auth (NextAuth v5, Google-only) ---
AUTH_SECRET=""                       # npx auth secret
AUTH_URL="http://localhost:6969"     # prod: https://www.synerix.in
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
SUPER_ADMIN_EMAIL="consulting.synerix@gmail.com"
DEV_AUTH_BYPASS="1"                  # dev only; inert in production builds

# --- Storage (Supabase) ---
NEXT_PUBLIC_SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""

# --- Trigger.dev v4 ---
TRIGGER_PROJECT_REF=""
TRIGGER_SECRET_KEY=""                # tr_dev_… locally, tr_prod_… on Vercel

# --- AI providers ---
ANTHROPIC_API_KEY=""                 # concepts, briefs, QA judges
GOOGLE_GENERATIVE_AI_API_KEY=""      # Gemini image models + marketing chat bot
OPENAI_API_KEY=""                    # gpt-image fallback
RUNWARE_API_KEY=""                   # seedream fallback
FIRECRAWL_API_KEY=""                 # brand-site ingest crawl
FAL_KEY=""                           # optional provider

# --- Email (Gmail SMTP: invites, enquiry, health-check reports) ---
GMAIL_USERNAME=""
GMAIL_PASSWORD=""                    # Gmail app password

# --- Marketing site ---
WEBSITE_URL="https://www.synerix.in"
WHATSAPP_NUMBER=""

# ---------------------------------------------------------------------------
# Cloudflare R2 — object storage (replaces Supabase Storage entirely).
#
# Get these from the Cloudflare dashboard:
#   R2 > Overview                     -> Account ID (right-hand sidebar)
#   R2 > API > Manage API Tokens      -> Create Account API token
#                                        Permission: "Object Read & Write"
#                                        Scope: specific bucket -> synerix-studio
#     ...which prints an Access Key ID + Secret Access Key ONCE. Copy both.
#
# The S3 endpoint is derived as https://<R2_ACCOUNT_ID>.r2.cloudflarestorage.com
# so it is not configured separately.
#
# These are also needed by the Trigger.dev workers (they upload renders), so
# add the same four to the Trigger.dev environment variables page.
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET="synerix-studio"

# Fingerprint device identification (marketing funnel only — see
# src/components/fingerprint.tsx). Use the SAME workspace/key as nexus.
# The public key ships in the client bundle by design; it is not a secret.
# Region must match the workspace region: us | eu | ap. Defaults to "ap".
NEXT_PUBLIC_FINGERPRINT_API_KEY=""
NEXT_PUBLIC_FINGERPRINT_REGION="ap"

# Optional tunables (all have sane defaults in code): PACK_QA_MAX_RETRIES,
# COMPOSE_VARIANTS, MAX_CONCEPTS_PER_RUN, MAX_CONCURRENT_CONCEPTS,
# IMAGE_PROVIDER, GEMINI_IMAGE_MODEL*, MODEL_* (per-stage LLM ids), PRICE_*,
# CREDITS_*, SIGNUP_CREDIT_GRANT, BRAND_INTEL_STALE_MS.
